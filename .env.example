# 本地开发示例（勿提交真实密码）
# Coze 导入后：在控制台配置同名变量；DATABASE_URL 等你初始化库后提供

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Opaque Session（Cookie 会话）；生产请换成长随机串
SESSION_SECRET=change-me-to-a-long-random-string

# 公网/Coze 反代时建议配置（登录 Origin 校验）
# APP_ORIGINS=https://xxxx-5000.dev.coze.site
TRUST_PROXY=true

# Origin 强校验默认关闭；需要时设为 true
ENFORCE_APP_ORIGINS=false

# 可选：对象存储（Coze 自动注入时可省略本地配置）
# COZE_STORAGE_URL=
# COZE_STORAGE_BUCKET=
# COZE_STORAGE_AK=
# COZE_STORAGE_SK=
